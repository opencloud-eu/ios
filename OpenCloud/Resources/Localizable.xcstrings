    "Some cellular data may still be used. To completely avoid the usage of cellular data, please turn off access to cellular for the entire app in the Settings app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es können weiterhin mobile Daten verwendet werden. Um die Nutzung mobiler Daten vollständig zu vermeiden, deaktivieren Sie bitte den mobilen Zugriff für die gesamte App in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some cellular data may still be used. To completely avoid the usage of cellular data, please turn off access to cellular for the entire app in the Settings app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données cellulaires peuvent encore être utilisées. Pour éviter complètement l'utilisation des données cellulaires, veuillez désactiver l'accès aux données cellulaires pour toute l'application dans les paramètres de l'app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige cellulaire gegevens kunnen nog steeds worden gebruikt. Om het gebruik van mobiele gegevens volledig te vermijden, schakelt u de toegang tot mobiele gegevens uit voor de hele app in de app Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część danych sieci komórkowej nadal może być używana. Aby tego uniknąć, wyłącz dostęp do sieci komórkowej dla aplikacji w Ustawieniach systemowych."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss mobildata kan fortfarande användas. Stäng av mobildataåtkomst för hela appen i Inställningar för att helt undvika användning av mobildata."
          }
        }
      }
    },
