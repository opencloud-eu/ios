    },
    "If you choose \"Immediately\" the App will be locked, when it is no longer in foreground." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie 'Sofort' wählen, wird die App gesperrt, sobald sie nicht mehr im Vordergrund ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous choisissez « Immédiatement », l'app sera verrouillée dès qu'elle ne sera plus au premier plan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u \"Onmiddellijk\" kiest, wordt de app vergrendeld als deze niet langer op de voorgrond staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli wybierzesz „Natychmiast”, aplikacja zostanie zablokowana po opuszczeniu jej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du väljer ”Omedelbart” låses appen när den inte längre är i förgrunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν επιλέξετε «Άμεσα», η εφαρμογή θα κλειδώνεται όταν δεν βρίσκεται πλέον στο προσκήνιο."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vel du «Med ein gong», vert appen låst når han ikkje lenger er i forgrunnen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger du «Umiddelbart», låses appen når den ikke lenger er i forgrunnen."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果选择“立即”，应用将在切换到后台时锁定。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you choose \"Immediately\" the App will be locked, when it is no longer in foreground."
          }
        }
      }
    },
    "If you have a moment to give us your feedback, please take our survey." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie einen Moment Zeit haben, um uns Ihr Feedback zu geben, nehmen Sie bitte an unserer Umfrage teil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez un moment pour nous donner votre avis, veuillez répondre à notre enquête."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u even de tijd heeft om ons uw reactie te geven, vul dan onze enquête in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli masz chwilę, wypełnij naszą ankietę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du har en stund över får du gärna ge oss återkoppling genom att besvara vår enkät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν έχετε λίγο χρόνο για να μας πείτε τη γνώμη σας, παρακαλούμε συμπληρώστε την έρευνά μας."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du tid til å gje oss tilbakemelding, kan du svare på undersøkinga vår."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har et øyeblikk til å gi oss tilbakemeldingen din, ta gjerne undersøkelsen vår."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a moment to give us your feedback, please take our survey."
          }
        }
      }
    },
    "If you make an item a favorite, it will turn up here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie ein Element als Favorit markieren, erscheint es hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous ajoutez un élément aux favoris, il apparaîtra ici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u een item favoriet maakt, verschijnt het hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli oznaczysz element jako ulubiony, pojawi się on tutaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du markerar ett objekt som favorit visas det här."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν προσθέσετε ένα στοιχείο στα αγαπημένα, θα εμφανίζεται εδώ."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkjer du eit element som favoritt, vert det vist her."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du markerer et element som favoritt, vil det vises her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you make an item a favorite, it will turn up here."
          }
        }
      }
    },
    "If you would like background media uploads to be more reliable, you should enable background location updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie möchten, dass Hintergrund-Medienuploads zuverlässiger sind, sollten Sie die Hintergrundstandortaktualisierungen aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rendre les téléversements de médias en arrière-plan plus fiables, activez les mises à jour de localisation en arrière-plan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u wilt dat achtergrondmedia-uploads betrouwbaarder zijn, moet u achtergrondlocatie-updates inschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przesyłanie w tle było bardziej niezawodne, włącz odświeżanie lokalizacji w tle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill göra medieuppladdningar i bakgrunden mer tillförlitliga bör du aktivera platsuppdateringar i bakgrunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν επιθυμείτε οι μεταφορτώσεις πολυμέσων στο παρασκήνιο να είναι πιο αξιόπιστες, θα πρέπει να ενεργοποιήσετε τις ενημερώσεις τοποθεσίας στο παρασκήνιο."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du at opplasting av media i bakgrunnen skal vere meir påliteleg, bør du slå på plasseringsoppdateringar i bakgrunnen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil at bakgrunnsmediaopplastinger skal være mer pålitelige, bør du slå på bakgrunnsplasseringsoppdateringer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you would like background media uploads to be more reliable, you should enable background location updates."
          }
        }
      }
    },
    "If you'd like to give the account a custom name, please enter it below:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie dem Konto einen eigenen Namen geben möchten, geben Sie ihn bitte unten ein:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous souhaitez donner un nom personnalisé au compte, saisissez-le ci-dessous :"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u het account een aangepaste naam wilt geven, kunt u deze hieronder invoeren:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz nadać kontu własną nazwę, wpisz ją poniżej:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill ge kontot ett eget namn anger du det nedan:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν θέλετε να δώσετε ένα προσαρμοσμένο όνομα στον λογαριασμό, παρακαλούμε εισαγάγετέ το παρακάτω:"
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du gje kontoen eit eige namn, kan du skrive det nedanfor:"
          }
        },
        "no" : {
