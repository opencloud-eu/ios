        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomsttokenen för anslutningen har löpt ut eller blivit ogiltig. Logga in igen för att återfå åtkomst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το διακριτικό πρόσβασης της σύνδεσης έχει λήξει ή δεν είναι έγκυρο. Συνδεθείτε ξανά για να αποκτήσετε πρόσβαση."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgangstokenet for tilkoplinga har gått ut eller er ugyldig. Logg inn på nytt for å få tilgang att."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgangstokenet for tilkoblingen har utløpt eller blitt ugyldig. Logg inn på nytt for å få tilgang igjen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection's access token has expired or become invalid. Sign in again to re-gain access."
          }
        }
      }
    },
    "The destination this shortcut points to could not be found. It may have been deleted or you may not have access to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel, auf das diese Verknüpfung verweist, konnte nicht gefunden werden. Es wurde möglicherweise gelöscht oder Sie haben keinen Zugriff darauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destination vers laquelle pointe ce raccourci est introuvable. Elle a peut-être été supprimée ou vous n'y avez peut-être pas accès."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bestemming waarnaar deze snelkoppeling verwijst, kon niet worden gevonden. Mogelijk is het verwijderd of heeft u er geen toegang toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce docelowe skrótu nie mogło zostać znalezione. Mogło zostać usunięte lub brak do niego dostępu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destinationen som genvägen pekar på kunde inte hittas. Den kan ha tagits bort eller så saknar du åtkomst till den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο προορισμός στον οποίο οδηγεί αυτή η συντόμευση δεν ήταν δυνατό να βρεθεί. Ενδέχεται να έχει διαγραφεί ή να μην έχετε πρόσβαση σε αυτόν."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fann ikkje målet som denne snarvegen peikar til. Det kan vere sletta, eller du har kanskje ikkje tilgang til det."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fant ikke målet som denne snarveien peker til. Det kan være slettet, eller du har kanskje ikke tilgang til det."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The destination this shortcut points to could not be found. It may have been deleted or you may not have access to it."
          }
        }
      }
    },
