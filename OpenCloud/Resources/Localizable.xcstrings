          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u een item favoriet maakt, verschijnt het hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli oznaczysz element jako ulubiony, pojawi się on tutaj."
