    "The connection's access token has expired or become invalid. Sign in again to re-gain access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriffstoken der Verbindung ist abgelaufen oder ungültig geworden. Melden Sie sich erneut an, um Zugriff zu erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton d'accès de la connexion a expiré ou est devenu invalide. Connectez-vous à nouveau pour rétablir l'accès."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het toegangstoken is verlopen of ongeldig geworden. Meld opnieuw aan om weer toegang te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token dostępu wygasł lub stał się nieważny. Zaloguj się ponownie."
