    "Cellular Data Usage have been disabled via MDM configuration. Please contact your administrator for more information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilfunkdaten-Nutzung wurde über die MDM-Konfiguration deaktiviert. Bitte wenden Sie sich für weitere Informationen an Ihren Administrator."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilisation des données cellulaires a été désactivée via la configuration MDM. Veuillez contacter votre administrateur pour plus d'informations."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gebruik van mobiele gegevens is uitgeschakeld via de MDM-configuratie. Neem contact op met uw beheerder voor meer informatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użycie danych sieci komórkowej zostało wyłączone przez konfigurację MDM. Skontaktuj się z administratorem, aby uzyskać więcej informacji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användning av mobildata har inaktiverats via MDM-konfiguration. Kontakta administratören för mer information."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χρήση δεδομένων κινητού δικτύου έχει απενεργοποιηθεί μέσω παραμέτρων MDM. Παρακαλούμε επικοινωνήστε με τον διαχειριστή σας για περισσότερες πληροφορίες."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk av mobildata er slått av via MDM-oppsett. Ta kontakt med administratoren for meir informasjon."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk av mobildata er slått av via MDM-oppsett. Kontakt administratoren for mer informasjon."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于移动设备管理（MDM）策略设置，移动数据已被禁用。如需了解详情，请联系管理员。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellular Data Usage have been disabled via MDM configuration. Please contact your administrator for more information."
