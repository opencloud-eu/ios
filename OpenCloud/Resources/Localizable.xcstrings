    "If you would like background media uploads to be more reliable, you should enable background location updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie möchten, dass Hintergrund-Medienuploads zuverlässiger sind, sollten Sie die Hintergrundstandortaktualisierungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you would like background media uploads to be more reliable, you should enable background location updates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rendre les téléversements de médias en arrière-plan plus fiables, activez les mises à jour de localisation en arrière-plan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u wilt dat achtergrondmedia-uploads betrouwbaarder zijn, moet u achtergrondlocatie-updates inschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przesyłanie w tle było bardziej niezawodne, włącz odświeżanie lokalizacji w tle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill göra medieuppladdningar i bakgrunden mer tillförlitliga bör du aktivera platsuppdateringar i bakgrunden."
