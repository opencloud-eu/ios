    "Otherwise background media uploads using background refresh technology would depend on how frequently you use the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andernfalls würden Hintergrund-Uploads von Medien über die Hintergrundaktualisierung davon abhängen, wie häufig Sie die App verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinon, les téléchargements de médias en arrière-plan à l'aide de la technologie d'actualisation en arrière-plan dépendront de la fréquence à laquelle vous utilisez l'application."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anders zouden achtergrondmedia-uploads met behulp van achtergrondvernieuwingstechnologie afhangen van hoe vaak u de app gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przeciwnym razie przesyłanie multimediów w tle zależałoby od tego, jak często używasz aplikacji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annars beror medieuppladdningar i bakgrunden som använder bakgrundsuppdateringsteknik på hur ofta du använder appen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαφορετικά, οι μεταφορτώσεις πολυμέσων στο παρασκήνιο με χρήση της τεχνολογίας ανανέωσης στο παρασκήνιο θα εξαρτώνται από το πόσο συχνά χρησιμοποιείτε την εφαρμογή."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles ville opplasting av media i bakgrunnen med bakgrunnsoppdatering vere avhengig av kor ofte du brukar appen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellers ville opplasting av medier i bakgrunnen med bakgrunnsoppdatering være avhengig av hvor ofte du bruker appen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
