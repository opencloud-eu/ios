    "Search on the server is unavailable while not connected. To search offline, switch to the Account scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serversuche ist ohne Verbindung nicht verfügbar. Um offline zu suchen, wechseln Sie zum Kontobereich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche sur le serveur est indisponible hors connexion. Pour rechercher hors ligne, passez en mode Compte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken op de server is niet beschikbaar als er geen verbinding is. Om offline te zoeken, schakelt u over naar de Account-scope."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie na serwerze nie jest dostępne offline. Przełącz na konto, aby wyszukiwać lokalnie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökning på servern är inte tillgänglig när du inte är ansluten. Växla till kontoomfånget för att söka offline."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναζήτηση στον διακομιστή δεν είναι διαθέσιμη όταν δεν είστε συνδεδεμένοι. Για αναζήτηση εκτός σύνδεσης, μεταβείτε στο εύρος «Λογαριασμός»."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk på tenaren er ikkje tilgjengeleg når du er fråkopla. Byt til omfanget Konto for å søkje fråkopla."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk på tjeneren er ikke tilgjengelig når du er frakoblet. Bytt til omfanget Konto for å søke frakoblet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search on the server is unavailable while not connected. To search offline, switch to the Account scope."
          }
        }
      }
    },
